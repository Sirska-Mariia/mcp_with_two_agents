# Оберіть ОДИН провайдера. Усі варіанти безкоштовні.

# --- Варіант 1 (типово): Groq. Ключ: console.groq.com, без картки ---
#PROVIDER=groq
#GROQ_API_KEY= ...
#MODEL= ...

# --- Варіант 2: OpenRouter (лише моделі з суфіксом :free; фільтр "tools" на сторінці моделей) ---
#PROVIDER=openrouter
#OPENROUTER_API_KEY= ...
#MODEL= ...    #<id-моделі>:free

# --- Варіант 3: Ollama локально (ліміту немає; модель має підтримувати tool calling) ---
# PROVIDER=ollama
# MODEL=<назва моделі, яку ви завантажили через ollama pull>

# --- Варіант 4: будь-який інший OpenAI-сумісний сервіс ---
# PROVIDER=custom
# BASE_URL=https://.../v1
# API_KEY=...
# MODEL=...
# LIMIT_RPM=10
# LIMIT_RPD=100

# Ліміти можна перевизначити під ваш акаунт (0 = без ліміту):
# LIMIT_RPM=30
# LIMIT_RPD=1000
# LIMIT_TPM=8000
# LIMIT_TPD=200000
